@model FarmaciaNuevaVida.Models.Producto

@{
    ViewData["Title"] = "Registrar producto";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <div class="card shadow border-0">

                <div class="card-header bg-primary text-white text-center py-4">
                    <h2 class="mb-1">Registrar producto</h2>
                    <p class="mb-0">
                        Farmacia Nueva Vida
                    </p>
                </div>

                <div class="card-body p-4 p-md-5">

                    <form asp-action="Registrar" method="post">

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold">
                                Nombre del producto
                            </label>

                            <input asp-for="Nombre"
                                   class="form-control"
                                   placeholder="Ej. Vitamina C" />

                            <span asp-validation-for="Nombre"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Tipo" class="form-label fw-bold">
                                Tipo de producto
                            </label>

                            <select asp-for="Tipo" class="form-select">
                                <option value="">Seleccione un tipo</option>
                                <option value="Natural">Natural</option>
                                <option value="Químico">Químico</option>
                                <option value="Líquido">Líquido</option>
                            </select>

                            <span asp-validation-for="Tipo"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Cantidad" class="form-label fw-bold">
                                Cantidad
                            </label>

                            <input asp-for="Cantidad"
                                   class="form-control"
                                   type="number"
                                   min="1"
                                   placeholder="Ingrese la cantidad" />

                            <span asp-validation-for="Cantidad"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PrecioUnitario" class="form-label fw-bold">
                                Precio unitario
                            </label>

                            <div class="input-group">
                                <span class="input-group-text">₡</span>

                                <input asp-for="PrecioUnitario"
                                       class="form-control"
                                       type="number"
                                       min="0.01"
                                       step="0.01"
                                       placeholder="0.00" />
                            </div>

                            <span asp-validation-for="PrecioUnitario"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">

                            <a asp-controller="Home"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                ← Volver
                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Registrar producto
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}